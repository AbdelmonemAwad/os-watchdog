#
# Why the host last reset, as its chipset recorded it: read, logged, kept for the page and cleared for
# the next boot - scripts/watchdog/reset_reason.py. Early among the start hooks, so it is kept before
# anything else in this boot can go wrong, and after os-xgs-npu's 06-xgs-reset-reason, whose record
# it takes where that is installed. Never fails the boot.
R=/usr/local/opnsense/scripts/watchdog/reset_reason.py
[ -x "${R}" ] || exit 0
"${R}" boot > /dev/null 2>&1
exit 0
